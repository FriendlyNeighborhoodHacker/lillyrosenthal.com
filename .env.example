# Copy to `.env` (git-ignored) and fill in. Used by `npm run upload-media` and by the build.
#
# 1. Cloudflare dashboard → R2 → Create bucket (e.g. "lillyrosenthal-media").
# 2. R2 → Manage R2 API Tokens → Create API token
#      Permissions: Object Read & Write, scoped to that bucket. Copy the two keys below.
# 3. Make the bucket public: bucket → Settings → Public access.
#      Either connect a custom domain (recommended, e.g. media.lillyrosenthal.com)
#      or enable the r2.dev subdomain (fine for testing; rate-limited for real traffic).
#    Put that public origin in PUBLIC_MEDIA_BASE (no trailing slash).

R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET=lillyrosenthal-media

# Where the site loads media from. Blank = serve the local files in public/media.
# After uploading, set this to the bucket's public origin, e.g.
#   PUBLIC_MEDIA_BASE=https://media.lillyrosenthal.com
#   PUBLIC_MEDIA_BASE=https://pub-xxxxxxxxxxxxxxxx.r2.dev
PUBLIC_MEDIA_BASE=
