---
/**
 * Full-bleed video/image slideshow.
 *
 * - Videos autoplay muted and advance when they end; images stay for
 *   `duration` seconds (default siteConfig.imageDuration).
 * - Media is sized by a focal-point fit (see siteConfig.display): each slide
 *   carries resolved `wide` and `narrow` FitRules, and layoutMedia() below
 *   positions the <video>/<img> so the chosen centerX/centerY sits at the
 *   middle of the stage, clamped so no gap shows.
 * - Floating controls (bottom right): sound on/off (persisted in
 *   localStorage) and pause/play (videos only).
 * - Prev/next arrows, keyboard arrows, swipe, hold-to-pause on images.
 */
import type { Slide } from '../data/slides';
import { siteConfig } from '../data/siteConfig';

interface Props {
  slides: Slide[];
  /** Append " · i / n" to the title. */
  showCounter?: boolean;
  /** Open on the first slide not seen recently (section pages). */
  smartStart?: boolean;
}

const { slides, showCounter = false, smartStart = false } = Astro.props;
const first = slides[0];
const isDev = import.meta.env.DEV;
const showClock = siteConfig.showClock === 'always' || (siteConfig.showClock === 'dev' && isDev);

const boxed = (s?: Slide) => Boolean(s && s.titleBackground && s.titleBackground !== 'none');
const titleStyle = (s?: Slide) => (boxed(s) ? `--title-bg: ${s!.titleBackground}; --title-color: ${s!.titleColor};` : '');

// Breakpoint-dependent rules live here (not in global.css) so siteConfig is
// the single source of truth for the numbers.
const bp = siteConfig.breakpoint;
const barBp = siteConfig.mobileBarBreakpoint;
const inlineCss = `
  .slideshow { height: ${siteConfig.stage.wide.height}; }
  @media (max-width: ${bp - 1}px) { .slideshow { height: ${siteConfig.stage.narrow.height}; } }
  @media (max-width: ${barBp}px) {
    .slide-title { left: 0; right: 0; bottom: 0; width: 100%; padding: 16px 20px; padding-bottom: calc(16px + env(safe-area-inset-bottom)); }
    .slide-title.boxed { background: var(--title-bg, #000); color: var(--title-color, #fff); }
    .page-home.menu-white .slide-title:not(.boxed) { background: white; color: #222; text-shadow: none !important; }
    .page-home.menu-black .slide-title:not(.boxed) { background: black; color: white; text-shadow: none !important; }
    .clip-clock { right: 16px; bottom: calc(var(--bar-h, 48px) + 14px + env(safe-area-inset-bottom)); }
  }
`;
---

<style is:inline set:html={inlineCss}></style>

<div class="slideshow-wrapper">
  <div
    class="slideshow"
    id="slideshow"
    data-breakpoint={bp}
    data-image-duration={siteConfig.imageDuration}
    data-show-counter={showCounter ? 'true' : 'false'}
    data-sound-key={siteConfig.soundStorageKey}
    data-dev={isDev ? 'true' : 'false'}
    data-clock={showClock ? 'true' : 'false'}
    data-smart-start={smartStart ? 'true' : 'false'}
    data-seen-key={siteConfig.seenStorageKey}
    data-seen-after={siteConfig.seenAfterSeconds}
    data-seen-window={siteConfig.seenWindowMinutes}
    style={`background: ${siteConfig.transition.color || '#000'};`}
  >
    {slides.map((slide, index) => (
      <div
        class={`slide${index === 0 ? ' active' : ''}`}
        data-key={slide.key}
        data-type={slide.type}
        data-link={slide.link || ''}
        data-menu-color={slide.menuColor}
        data-shadow-color={slide.shadowColor}
        data-title={slide.title || ''}
        data-title-bg={boxed(slide) ? slide.titleBackground : ''}
        data-title-color={slide.titleColor}
        data-duration={slide.duration ?? ''}
        data-start={slide.start ?? ''}
        data-end={slide.end ?? ''}
        data-transition={JSON.stringify(slide.transition)}
        data-narrow-shift={slide.narrowShift ?? ''}
        data-width={slide.width}
        data-height={slide.height}
        data-fit={JSON.stringify({ wide: slide.wide, narrow: slide.narrow })}
        style={`background-color: ${slide.sideColor};`}
      >
        {slide.type === 'video' ? (
          <video
            class="media"
            muted
            playsinline
            webkit-playsinline
            preload={index === 0 ? 'auto' : 'none'}
            poster={slide.poster}
            src={index === 0 ? slide.src : undefined}
            data-src={slide.src}
            width={slide.width}
            height={slide.height}
            aria-label={slide.title}
          />
        ) : (
          <img
            class="media"
            src={slide.src}
            alt={slide.title || ''}
            loading={index === 0 ? 'eager' : 'lazy'}
            width={slide.width}
            height={slide.height}
          />
        )}
      </div>
    ))}

    <div
      class={`slide-title${boxed(first) ? ' boxed' : ''}`}
      id="slide-title"
      style={titleStyle(first)}
      hidden={!first?.title && !showCounter}
    >
      {first?.link
        ? <a class="slide-title-text" href={first.link}>{first.title}</a>
        : <span class="slide-title-text">{first?.title}</span>}
      <span class="slide-title-count">{showCounter && slides.length > 1 ? `· 1 / ${slides.length}` : ''}</span>
    </div>

    {slides.length > 1 && (
      <>
        <button class="slide-arrow prev" id="slide-prev" aria-label="Previous">&lt;</button>
        <button class="slide-arrow next" id="slide-next" aria-label="Next">&gt;</button>
      </>
    )}

    {showClock && (
      <span class="clip-clock" id="clip-clock" title="Video file time: current / total seconds (use for start / end)" hidden>
        <span class="clock-now">0.0</span> / <span class="clock-dur">0.0</span>
      </span>
    )}

    <div class="player-controls">
      <span class="sound-hint" id="sound-hint" hidden>Tap for sound</span>
      <button class="player-btn" id="sound-toggle" type="button" aria-label="Turn sound on" aria-pressed="false">
        <svg class="icon-off" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M3 9v6h4l5 5V4L7 9H3z"/>
          <path d="M20.6 9.4 19.2 8l-2.5 2.5L14.2 8l-1.4 1.4 2.5 2.6-2.5 2.6 1.4 1.4 2.5-2.5 2.5 2.5 1.4-1.4-2.5-2.6z"/>
        </svg>
        <svg class="icon-on" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M3 9v6h4l5 5V4L7 9H3z"/>
          <path d="M16.5 12a4.5 4.5 0 0 0-2.5-4v8a4.5 4.5 0 0 0 2.5-4z"/>
          <path d="M14 3.2v2.1a7 7 0 0 1 0 13.4v2.1a9 9 0 0 0 0-17.6z"/>
        </svg>
      </button>
      <button class="player-btn" id="play-toggle" type="button" aria-label="Pause" hidden={first?.type !== 'video'}>
        <svg class="icon-play" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
        <svg class="icon-pause" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 5h4v14H6zM14 5h4v14h-4z"/></svg>
      </button>
    </div>
  </div>
</div>

<script>
  (function () {
    const showEl = document.getElementById('slideshow');
    if (!showEl) return;
    const slides = Array.from(showEl.querySelectorAll<HTMLElement>('.slide'));
    if (!slides.length) return;

    /* narrowShift: on narrow screens, reorder slides before anything else runs.
       Each shifted slide moves (in file order) by its offset, clamped to the ends. */
    if (!window.matchMedia(`(min-width: ${Number(showEl.dataset.breakpoint) || 1000}px)`).matches) {
      const order = slides.slice();
      let changed = false;
      for (const el of slides) {
        const shift = Math.trunc(Number(el.dataset.narrowShift) || 0);
        if (!shift) continue;
        const from = order.indexOf(el);
        const to = Math.min(Math.max(from + shift, 0), order.length - 1);
        if (to === from) continue;
        order.splice(from, 1);
        order.splice(to, 0, el);
        changed = true;
      }
      if (changed) {
        const anchor = slides[slides.length - 1].nextSibling;   // keep slides ahead of the overlay/controls
        order.forEach((el) => showEl.insertBefore(el, anchor));
        slides.splice(0, slides.length, ...order);
        slides.forEach((el, i) => el.classList.toggle('active', i === 0));
      }
    }

    const cfg = {
      breakpoint: Number(showEl.dataset.breakpoint) || 1000,
      imageDurationMs: (Number(showEl.dataset.imageDuration) || 6) * 1000,
      showCounter: showEl.dataset.showCounter === 'true',
      soundKey: showEl.dataset.soundKey || 'lr-sound',
      isDev: showEl.dataset.dev === 'true',
      smartStart: showEl.dataset.smartStart === 'true',
      seenKey: showEl.dataset.seenKey || 'lr-seen',
      seenAfterSec: Number(showEl.dataset.seenAfter) || 3,
      seenWindowMs: (Number(showEl.dataset.seenWindow) || 10) * 60 * 1000,
    };

    /* ------------------------------------------------------------ "seen" memory (localStorage) */
    function readSeen(): Record<string, number> {
      try { return JSON.parse(localStorage.getItem(cfg.seenKey) || '{}') || {}; } catch { return {}; }
    }
    function markSeen(key: string) {
      if (!key) return;
      const now = Date.now();
      const m = readSeen();
      for (const k of Object.keys(m)) if (now - m[k] > cfg.seenWindowMs) delete m[k];
      m[key] = now;
      try { localStorage.setItem(cfg.seenKey, JSON.stringify(m)); } catch { /* private mode etc. */ }
    }
    function seenRecently(key: string) {
      const t = readSeen()[key];
      return Boolean(t) && Date.now() - t < cfg.seenWindowMs;
    }

    const prevBtn = document.getElementById('slide-prev');
    const nextBtn = document.getElementById('slide-next');
    const titleEl = document.getElementById('slide-title') as HTMLElement | null;
    let titleText = titleEl?.querySelector('.slide-title-text') as HTMLElement | null;
    const titleCount = titleEl?.querySelector('.slide-title-count') as HTMLElement | null;
    const soundBtn = document.getElementById('sound-toggle') as HTMLButtonElement;
    const soundHint = document.getElementById('sound-hint') as HTMLElement | null;
    const playBtn = document.getElementById('play-toggle') as HTMLButtonElement;
    const wideMQ = window.matchMedia(`(min-width: ${cfg.breakpoint}px)`);

    let current = 0;
    let imageTimer: number | undefined;
    let isAnimating = false;
    let wasDrag = false;
    let userPaused = false;        // the visitor pressed pause
    let soundBlocked = false;      // sound is "on" but the browser refused unmuted autoplay
    let soundEverPlayed = false;   // an unmuted play() has succeeded on this page
    let soundOn = false;
    try { soundOn = localStorage.getItem(cfg.soundKey) === 'on'; } catch { /* private mode etc. */ }

    type FitRule = { fit?: string; scale?: number; centerX?: number; centerY?: number; alignX?: string; alignY?: string };
    const mediaOf = (el: HTMLElement) => el.querySelector('.media') as HTMLVideoElement | HTMLImageElement | null;
    const videoOf = (el: HTMLElement) => (el.dataset.type === 'video' ? (mediaOf(el) as HTMLVideoElement | null) : null);
    const isWide = () => wideMQ.matches;
    const startOf = (el: HTMLElement) => Math.max(0, Number(el.dataset.start) || 0);
    const endOf = (el: HTMLElement) => { const e = Number(el.dataset.end); return e > startOf(el) ? e : Infinity; };
    type Transition = { type?: string; duration?: number };
    const transitionOf = (el: HTMLElement): Transition => { try { return JSON.parse(el.dataset.transition || '{}'); } catch { return {}; } };
    const setFadeMs = (el: HTMLElement, ms: number) => { el.style.transitionDuration = `${ms}ms`; };
    /** Seek now, or as soon as the duration is known. */
    function seekTo(v: HTMLVideoElement, t: number) {
      const go = () => { try { v.currentTime = t; } catch { /* not seekable yet */ } };
      if (v.readyState >= 1) go(); else v.addEventListener('loadedmetadata', go, { once: true });
    }

    /* ------------------------------------------------------------ layout
       Focal-point fit: size the media per the fit rule, then slide it so the
       (centerX, centerY) point of the media sits at the center of the stage,
       clamped so an edge never shows a gap. Where the media is smaller than
       the stage, alignX/alignY say where it sits. */
    function layoutMedia(el: HTMLElement) {
      const m = mediaOf(el);
      if (!m) return;
      const sw = el.clientWidth;
      const sh = el.clientHeight;
      if (!sw || !sh) return;
      let mw = Number(el.dataset.width) || 0;
      let mh = Number(el.dataset.height) || 0;
      if (!mw || !mh) {
        mw = (m as HTMLVideoElement).videoWidth || (m as HTMLImageElement).naturalWidth || 0;
        mh = (m as HTMLVideoElement).videoHeight || (m as HTMLImageElement).naturalHeight || 0;
      }
      if (!mw || !mh) return;

      let rules: { wide?: FitRule; narrow?: FitRule } = {};
      try { rules = JSON.parse(el.dataset.fit || '{}'); } catch { rules = {}; }
      const r: FitRule = (isWide() ? rules.wide : rules.narrow) || {};
      const fit = r.fit || 'cover';
      const sx = sw / mw;
      const sy = sh / mh;
      let s = fit === 'cover' ? Math.max(sx, sy)
        : fit === 'contain' ? Math.min(sx, sy)
        : fit === 'height' ? sy
        : sx; // 'width'
      s *= Number(r.scale) || 1;
      const rw = mw * s;
      const rh = mh * s;

      const place = (rendered: number, stage: number, center: number, align: string) => {
        if (rendered >= stage - 0.5) {
          const want = (center / 100) * rendered - stage / 2;
          return -Math.min(Math.max(want, 0), rendered - stage);
        }
        const free = stage - rendered;
        if (align === 'left' || align === 'top') return 0;
        if (align === 'right' || align === 'bottom') return free;
        return free / 2;
      };
      const x = place(rw, sw, r.centerX ?? 50, r.alignX || 'center');
      const y = place(rh, sh, r.centerY ?? 50, r.alignY || 'center');

      m.style.width = `${rw}px`;
      m.style.height = `${rh}px`;
      m.style.transform = `translate3d(${x}px, ${y}px, 0)`;
      m.classList.add('laid-out');
    }
    function layoutAll() { slides.forEach(layoutMedia); }

    window.addEventListener('resize', layoutAll);
    window.addEventListener('orientationchange', () => setTimeout(layoutAll, 50));
    wideMQ.addEventListener?.('change', layoutAll);

    /* ------------------------------------------------------------ chrome */
    function updateChrome() {
      const el = slides[current];
      const color = el.dataset.menuColor || 'white';
      document.body.classList.remove('menu-white', 'menu-black');
      document.body.classList.add('menu-' + color);

      const sc = el.dataset.shadowColor || '';
      const glow = sc ? `0 0 10px ${sc}, 0 0 20px ${sc}, 0 0 40px ${sc}, 0 0 80px ${sc}` : '';
      const siteTitle = document.querySelector('.site-title') as HTMLElement | null;
      if (siteTitle) siteTitle.style.textShadow = glow;
      document.querySelectorAll<HTMLElement>('.nav-menu > li > a').forEach((a) => { a.style.textShadow = glow; });

      if (titleEl && titleText && titleCount) {
        const title = el.dataset.title || '';
        const link = el.dataset.link || '';
        const wantTag = link ? 'A' : 'SPAN';
        if (titleText.tagName !== wantTag) {
          const fresh = document.createElement(link ? 'a' : 'span');
          fresh.className = 'slide-title-text';
          titleText.replaceWith(fresh);
          titleText = fresh;
        }
        if (link) (titleText as HTMLAnchorElement).href = link;
        titleText.textContent = title;
        titleCount.textContent = cfg.showCounter && slides.length > 1 ? `· ${current + 1} / ${slides.length}` : '';
        titleEl.hidden = !title && !titleCount.textContent;
        const bg = el.dataset.titleBg || '';
        if (bg) {
          titleEl.classList.add('boxed');
          titleEl.style.setProperty('--title-bg', bg);
          titleEl.style.setProperty('--title-color', el.dataset.titleColor || '#fff');
          titleEl.style.textShadow = '';
        } else {
          titleEl.classList.remove('boxed');
          titleEl.style.removeProperty('--title-bg');
          titleEl.style.removeProperty('--title-color');
          titleEl.style.textShadow = glow;
        }
        // Lets the clock sit just above the bottom bar on narrow screens.
        showEl.style.setProperty('--bar-h', `${titleEl.offsetHeight || 48}px`);
      }
    }

    function updateControls() {
      const v = videoOf(slides[current]);
      if (playBtn) {
        playBtn.hidden = !v;
        const playing = Boolean(v && !v.paused && !v.ended);
        playBtn.classList.toggle('is-playing', playing);
        playBtn.setAttribute('aria-label', playing ? 'Pause' : 'Play');
      }
      if (soundBtn) {
        const on = soundOn && !soundBlocked;
        const pending = soundOn && soundBlocked;   // wanted on, waiting for the first tap
        soundBtn.classList.toggle('is-on', on || pending);
        soundBtn.classList.toggle('is-pending', pending);
        soundBtn.setAttribute('aria-pressed', String(on));
        soundBtn.setAttribute('aria-label', pending ? 'Tap anywhere for sound' : on ? 'Turn sound off' : 'Turn sound on');
        if (soundHint) soundHint.hidden = !pending;
      }
    }

    /* ------------------------------------------------------------ playback */
    function ensureLoaded(el: HTMLElement) {
      const v = videoOf(el);
      if (v && !v.getAttribute('src')) {
        v.preload = 'auto';
        v.src = v.dataset.src || '';
        v.load();
      }
    }

    /** Ramp a video's volume over `ms` (no-op where volume is read-only, e.g. iOS). */
    function rampVolume(v: HTMLVideoElement, from: number, to: number, ms: number, done?: () => void) {
      const t0 = performance.now();
      try { v.volume = from; } catch { /* iOS */ }
      const step = (now: number) => {
        const k = ms > 0 ? Math.min(1, (now - t0) / ms) : 1;
        try { v.volume = from + (to - from) * k; } catch { /* iOS */ }
        if (k < 1) requestAnimationFrame(step); else done?.();
      };
      requestAnimationFrame(step);
    }

    /** Outgoing clip: keep playing while it fades (its sound blending down), then pause and rewind. */
    function stopVideo(el: HTMLElement, fadeMs: number) {
      const v = videoOf(el);
      if (!v) return;
      const finish = () => {
        if (videoOf(slides[current]) === v) return;   // we came back to it mid-fade
        v.pause();
        try { v.volume = 1; } catch { /* iOS */ }
        seekTo(v, startOf(el));
      };
      if (fadeMs > 0) {
        if (!v.paused) rampVolume(v, v.volume, 0, fadeMs, finish);
        else window.setTimeout(finish, fadeMs);   // ended / paused: hold the last frame while it fades
      } else finish();
    }

    /** Seconds the slide spends fading OUT when it is left (0 for a cut). */
    function fadeOutSecOf(el: HTMLElement) {
      const tr = transitionOf(el);
      if (tr.type === 'none') return 0;
      const d = Math.max(0, Number(tr.duration) || 0);
      return tr.type === 'fade' ? d / 2 : d;
    }

    /* End watcher: start the transition early enough that the clip is fully
       faded out at its `end` (or the end of the file), with the next slide
       already playing. Checked every frame while the slide is current. */
    let endWatch: number | undefined;
    function cancelEndWatch() {
      if (endWatch !== undefined) { cancelAnimationFrame(endWatch); endWatch = undefined; }
    }
    function reachedEnd(i: number, v: HTMLVideoElement) {
      if (i !== current) return;
      if (slides.length > 1) advance(1);
      else { v.pause(); updateControls(); }
    }
    function startEndWatch(el: HTMLElement, v: HTMLVideoElement) {
      cancelEndWatch();
      const idx = slides.indexOf(el);
      let marked = false;
      const step = () => {
        if (slides[current] !== el) { endWatch = undefined; return; }
        if (!marked && !v.paused && v.currentTime - startOf(el) >= cfg.seenAfterSec) { marked = true; markSeen(el.dataset.key || ''); }
        const fileEnd = isFinite(v.duration) && v.duration > 0 ? v.duration : Infinity;
        const stopAt = Math.min(endOf(el), fileEnd);
        const lead = slides.length > 1 ? fadeOutSecOf(el) : 0;
        const triggerAt = Math.max(startOf(el) + 0.5, stopAt - lead);
        if (!v.paused && !v.ended && isFinite(triggerAt) && v.currentTime >= triggerAt) {
          endWatch = undefined;
          reachedEnd(idx, v);
          return;
        }
        endWatch = requestAnimationFrame(step);
      };
      endWatch = requestAnimationFrame(step);
    }

    function clearImageTimer() {
      if (imageTimer !== undefined) { window.clearTimeout(imageTimer); imageTimer = undefined; }
    }

    function startImageTimer() {
      clearImageTimer();
      const el = slides[current];
      if (el.dataset.type !== 'image' || slides.length < 2) return;
      const ms = (Number(el.dataset.duration) || 0) * 1000 || cfg.imageDurationMs;
      imageTimer = window.setTimeout(() => advance(1), ms);
    }

    /* The browser refused unmuted autoplay even though sound is on: the first
       tap/click/key anywhere counts as the gesture that lets us unmute. */
    let gestureArmed = false;
    function armUnmuteOnGesture() {
      if (gestureArmed) return;
      gestureArmed = true;
      const onGesture = (e: Event) => {
        if ((e.target as HTMLElement | null)?.closest?.('.player-controls')) return; // the buttons handle themselves
        if (!(soundOn && soundBlocked)) return;
        const v = videoOf(slides[current]);
        soundBlocked = false;
        if (v) { v.muted = false; if (v.paused && !userPaused) void playCurrent(); }
        updateControls();
        document.removeEventListener('pointerdown', onGesture, true);
        document.removeEventListener('keydown', onGesture, true);
        gestureArmed = false;
      };
      document.addEventListener('pointerdown', onGesture, true);
      document.addEventListener('keydown', onGesture, true);
    }

    async function playCurrent() {
      const el = slides[current];
      const v = videoOf(el);
      if (!v) return;
      ensureLoaded(el);
      if (v.ended || v.currentTime >= endOf(el)) seekTo(v, startOf(el));
      v.muted = !soundOn;
      try {
        await v.play();
        if (soundOn) { soundBlocked = false; if (!v.muted) soundEverPlayed = true; }
      } catch (err) {
        const e = err as DOMException;
        console.warn('[slideshow] play() rejected:', e?.name, e?.message, '| sound on:', soundOn, '| muted:', v.muted, '| slide:', el.dataset.key, '| sound played before:', soundEverPlayed);
        // Retry once shortly if this is not a policy refusal (e.g. an AbortError from a
        // load/seek race), or if sound was already playing on this page (a refusal then
        // is unexpected and often transient).
        if (videoOf(slides[current]) === v && (e?.name !== 'NotAllowedError' || (soundOn && soundEverPlayed))) {
          await new Promise((r) => setTimeout(r, 300));
          try { await v.play(); updateControls(); return; } catch (err2) { console.warn('[slideshow] retry rejected:', (err2 as DOMException)?.name); }
        }
        if (soundOn && !v.muted) {
          // Unmuted autoplay refused by the browser: play muted, show the pending icon, keep the preference.
          soundBlocked = true;
          v.muted = true;
          armUnmuteOnGesture();
          try { await v.play(); } catch { /* needs a tap; play button is showing */ }
        }
      }
      updateControls();
    }

    function onSlideShown() {
      const el = slides[current];
      layoutMedia(el);
      updateChrome();
      if (el.dataset.type === 'video') {
        const v = videoOf(el)!;
        if (Math.abs(v.currentTime - startOf(el)) > 0.25) seekTo(v, startOf(el));
        if (userPaused) updateControls(); else void playCurrent();
        startEndWatch(el, v);
      } else {
        markSeen(el.dataset.key || '');
        startImageTimer();
        updateControls();
      }
      if (slides.length > 1) ensureLoaded(slides[(current + 1) % slides.length]);
    }

    /** Make slide n current (classes + playback + transition). Shared by arrows, keys, timers and swipes.
        The transition is the one configured on the slide being LEFT; swipes pass 'none' (already moved). */
    let revealTimer: number | undefined;
    function goTo(n: number, opts: { transition?: 'auto' | 'none' } = {}) {
      clearImageTimer();
      cancelEndWatch();
      if (revealTimer !== undefined) { window.clearTimeout(revealTimer); revealTimer = undefined; }
      const old = slides[current];
      const next = ((n % slides.length) + slides.length) % slides.length;
      const nextEl = slides[next];
      const tr = opts.transition === 'none' ? { type: 'none', duration: 0 } : transitionOf(old);
      const ms = tr.type === 'none' ? 0 : Math.max(0, Number(tr.duration) || 0) * 1000;

      current = next;
      userPaused = false;
      const outMs = tr.type === 'fade' ? ms / 2 : ms;
      if (old !== nextEl) stopVideo(old, outMs);
      ensureLoaded(nextEl);
      // Incoming sound blends up over the fade-in (only audible when sound is on).
      const nv = videoOf(nextEl);
      if (nv && ms > 0 && old !== nextEl) rampVolume(nv, 0, 1, outMs);

      if (tr.type === 'fade' && ms > 0 && old !== nextEl) {
        // Out to the stage color, then in.
        const half = ms / 2;
        setFadeMs(old, half);
        setFadeMs(nextEl, half);
        old.classList.remove('active');
        revealTimer = window.setTimeout(() => {
          revealTimer = undefined;
          nextEl.classList.add('active');
          onSlideShown();
        }, half);
      } else {
        // Crossfade (or an instant cut when ms is 0).
        setFadeMs(old, ms);
        setFadeMs(nextEl, ms);
        old.classList.remove('active');
        nextEl.classList.add('active');
        onSlideShown();
      }
    }

    function advance(d: number) {
      if (isAnimating) return;
      goTo(current + d);
    }

    function togglePlay() {
      const v = videoOf(slides[current]);
      if (!v) return;
      if (v.paused || v.ended) { userPaused = false; void playCurrent(); }
      else { userPaused = true; v.pause(); }
      updateControls();
    }

    function toggleSound() {
      soundOn = soundBlocked ? true : !soundOn;
      soundBlocked = false;
      try { localStorage.setItem(cfg.soundKey, soundOn ? 'on' : 'off'); } catch { /* ignore */ }
      const v = videoOf(slides[current]);
      if (v) {
        v.muted = !soundOn;
        if (soundOn && v.paused && !userPaused) void playCurrent();
      }
      updateControls();
    }

    /* ------------------------------------------------------------ video events */
    slides.forEach((el, i) => {
      const v = videoOf(el);
      if (!v) return;
      v.addEventListener('ended', () => reachedEnd(i, v));   // fallback (e.g. duration unknown)
      v.addEventListener('play', () => { if (i === current) updateControls(); });
      v.addEventListener('pause', () => { if (i === current) updateControls(); });
      v.addEventListener('loadedmetadata', () => { if (!el.dataset.width) layoutMedia(el); });
    });

    document.addEventListener('visibilitychange', () => {
      const el = slides[current];
      if (document.hidden) {
        clearImageTimer();
        videoOf(el)?.pause();
      } else if (el.dataset.type === 'video') {
        if (!userPaused) void playCurrent();
      } else {
        startImageTimer();
      }
    });

    /* ------------------------------------------------------------ controls */
    soundBtn?.addEventListener('click', (e) => { e.stopPropagation(); toggleSound(); });
    playBtn?.addEventListener('click', (e) => { e.stopPropagation(); togglePlay(); });
    prevBtn?.addEventListener('click', (e) => { e.stopPropagation(); advance(-1); });
    nextBtn?.addEventListener('click', (e) => { e.stopPropagation(); advance(1); });

    document.addEventListener('keydown', (e) => {
      const tag = (e.target as HTMLElement | null)?.tagName;
      if (tag === 'INPUT' || tag === 'TEXTAREA') return;
      if (tag === 'BUTTON' && (e.key === ' ' || e.key === 'Enter')) return; // let the focused button handle it
      if (e.key === 'ArrowLeft') advance(-1);
      else if (e.key === 'ArrowRight') advance(1);
      else if (e.key === ' ') { e.preventDefault(); togglePlay(); }
      else if (e.key === 'm' || e.key === 'M') toggleSound();
    });

    /* Click / tap on a slide: pause or play the video. (Links live in the title box.) */
    slides.forEach((slide) => {
      slide.addEventListener('click', (e) => {
        if (wasDrag || e.shiftKey) return;
        togglePlay();
      });
    });

    /* Dev helper: shift+click prints the focal point of the clicked spot. */
    if (cfg.isDev) {
      showEl.addEventListener('click', (e) => {
        if (!e.shiftKey) return;
        e.preventDefault(); e.stopPropagation();
        const el = slides[current];
        const m = mediaOf(el);
        if (!m) return;
        const rect = m.getBoundingClientRect();
        const pt = {
          key: el.dataset.key,
          viewport: isWide() ? 'wide' : 'narrow',
          centerX: Math.round(((e.clientX - rect.left) / rect.width) * 1000) / 10,
          centerY: Math.round(((e.clientY - rect.top) / rect.height) * 1000) / 10,
        };
        const snippet = `'${pt.key}': { ${pt.viewport}: { centerX: ${pt.centerX}, centerY: ${pt.centerY} } },`;
        console.log('[slideshow] focal point', pt, '\n' + snippet);
        navigator.clipboard?.writeText(snippet).catch(() => {});
      }, true);
    }

    /* ------------------------------------------------------------ touch / swipe (from judyrosenthal.com) */
    let touchStartX = 0;
    let touchStartY = 0;
    let isDragging = false;
    let adjIdx = -1;

    function cleanupDrag() {
      adjIdx = -1;
      slides.forEach((slide) => {
        slide.style.transition = 'none';
        slide.style.transform = '';
        slide.style.opacity = slide.classList.contains('active') ? '1' : '0';
      });
      requestAnimationFrame(() => {
        slides.forEach((slide) => { slide.style.transition = ''; slide.style.opacity = ''; });
      });
    }

    function commitToSlide(newIdx: number) {
      goTo(newIdx, { transition: 'none' });
      cleanupDrag();
      isAnimating = false;
    }

    const onControl = (t: EventTarget | null) => Boolean((t as HTMLElement | null)?.closest?.('.slide-arrow, .player-controls'));

    showEl.addEventListener('touchstart', (e) => {
      if (onControl(e.target)) return;
      if (e.changedTouches.length !== 1 || isAnimating) return;
      touchStartX = e.changedTouches[0].screenX;
      touchStartY = e.changedTouches[0].screenY;
      isDragging = false;
      wasDrag = false;
      adjIdx = -1;
      clearImageTimer();            // a finger on an image holds it
    }, { passive: true });

    showEl.addEventListener('touchmove', (e) => {
      if (onControl(e.target)) return;
      if (e.changedTouches.length !== 1 || isAnimating || slides.length < 2) return;
      const dx = e.changedTouches[0].screenX - touchStartX;
      const dy = e.changedTouches[0].screenY - touchStartY;

      if (!isDragging) {
        if (Math.abs(dx) < 8) return;
        if (Math.abs(dy) > Math.abs(dx)) return;
        isDragging = true;
        wasDrag = true;
        const w = showEl.offsetWidth;
        adjIdx = dx < 0 ? (current + 1) % slides.length : (current - 1 + slides.length) % slides.length;
        slides[current].style.transition = 'none';
        slides[adjIdx].style.transition = 'none';
        slides[adjIdx].style.opacity = '1';
        slides[adjIdx].style.transform = dx < 0 ? `translateX(${w}px)` : `translateX(-${w}px)`;
      }

      const w = showEl.offsetWidth;
      slides[current].style.transform = `translateX(${dx}px)`;
      slides[adjIdx].style.transform = dx < 0 ? `translateX(${w + dx}px)` : `translateX(${-w + dx}px)`;
    }, { passive: true });

    showEl.addEventListener('touchcancel', () => {
      if (!isDragging && !isAnimating) startImageTimer();
    }, { passive: true });

    showEl.addEventListener('touchend', (e) => {
      if (e.changedTouches.length !== 1) return;
      if (!isDragging) {
        if (!isAnimating) startImageTimer();   // finger lifted: full duration again
        return;
      }

      const dx = e.changedTouches[0].screenX - touchStartX;
      const w = showEl.offsetWidth;
      const fromIdx = current;
      const toIdx = adjIdx;
      const SNAP = 'transform 0.3s ease';
      const BACK = 'transform 0.2s ease';
      const isToNext = toIdx === (fromIdx + 1) % slides.length;

      isAnimating = true;

      if (Math.abs(dx) > 50 && toIdx >= 0) {
        slides[fromIdx].style.transition = SNAP;
        slides[toIdx].style.transition = SNAP;
        slides[fromIdx].style.transform = isToNext ? `translateX(-${w}px)` : `translateX(${w}px)`;
        slides[toIdx].style.transform = 'translateX(0)';
        slides[toIdx].addEventListener('transitionend', function onEnd(ev) {
          if ((ev as TransitionEvent).propertyName !== 'transform') return;
          slides[toIdx].removeEventListener('transitionend', onEnd as EventListener);
          commitToSlide(toIdx);
        });
      } else {
        slides[fromIdx].style.transition = BACK;
        slides[fromIdx].style.transform = 'translateX(0)';
        if (toIdx >= 0) {
          slides[toIdx].style.transition = BACK;
          slides[toIdx].style.transform = isToNext ? `translateX(${w}px)` : `translateX(-${w}px)`;
        }
        slides[fromIdx].addEventListener('transitionend', function onEnd(ev) {
          if ((ev as TransitionEvent).propertyName !== 'transform') return;
          slides[fromIdx].removeEventListener('transitionend', onEnd as EventListener);
          cleanupDrag();
          isAnimating = false;
          startImageTimer();
        });
      }
    }, { passive: true });

    /* ------------------------------------------------------------ clip clock */
    const clockEl = document.getElementById('clip-clock');
    if (clockEl && showEl.dataset.clock === 'true') {
      const nowEl = clockEl.querySelector('.clock-now') as HTMLElement;
      const durEl = clockEl.querySelector('.clock-dur') as HTMLElement;
      let lastText = '';
      const tick = () => {
        const v = videoOf(slides[current]);
        if (!v) { clockEl.hidden = true; }
        else {
          clockEl.hidden = false;
          const text = `${v.currentTime.toFixed(1)}|${isFinite(v.duration) ? v.duration.toFixed(1) : '…'}`;
          if (text !== lastText) {
            lastText = text;
            const [a, b] = text.split('|');
            nowEl.textContent = a;
            durEl.textContent = b;
          }
        }
        requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    }

    /* ------------------------------------------------------------ init */
    if (cfg.smartStart && slides.length > 1) {
      const idx = slides.findIndex((el) => !seenRecently(el.dataset.key || ''));
      if (idx > 0) {
        setFadeMs(slides[0], 0);
        setFadeMs(slides[idx], 0);
        slides[0].classList.remove('active');
        slides[idx].classList.add('active');
        current = idx;
      }
    }
    layoutAll();
    onSlideShown();
  })();
</script>
