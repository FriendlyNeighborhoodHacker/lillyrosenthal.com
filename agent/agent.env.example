# ~/agents/lillyrosenthal.org/agent.env (chmod 600): this agent's secrets and
# knobs. One account can run an agent per site; each lives in its own
# ~/agents/<site>/ with its own agent.env, clone, worktrees and unit. Loaded by
# the systemd unit and, for debugging, with:
#   set -a; source ~/agents/lillyrosenthal.org/agent.env; set +a
AGENT_DIR=/home/lillyrosenthal/agents/lillyrosenthal.org

# Either an Anthropic Console API key (metered separately on the Console org)...
# ANTHROPIC_API_KEY=sk-ant-...
# ...or nothing here and a `claude` login stored under this account's ~/.claude
# (`claude` then `/login`), or a subscription token from `claude setup-token`:
# CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-...
# If both a key and a token are set the key wins.

# Discord: the "SWE - lillyrosenthal.org" bot's token, and the numeric ID of
# the channel it watches (right-click the channel > Copy Channel ID).
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=

# Discord role names. builder: request, discuss, review, discard.
# shipper: may also "approve" (= push to main = deploy to lillyrosenthal.org).
ROLE_BUILDER=builder
ROLE_SHIPPER=shipper

# Model Claude Code runs with, and what to try when it is overloaded or not
# available to this account. Aliases (fable, opus, sonnet) mean the latest.
CODE_MODEL=fable
FALLBACK_MODEL=opus,sonnet

# Spending cap for ONE agent turn, in US dollars; seconds a turn may run.
MAX_BUDGET_USD=10
CLAUDE_TIMEOUT_SECONDS=3600

# Previews: https://<PREVIEW_PREFIX>-<slug>.<PREVIEW_DOMAIN>/ serves
# ~/previews/<PREVIEW_PREFIX>-<slug>/www, which agent/preview-setup.sh builds
# from the worktree. The prefix must start with the account's provisioned
# prefix ("lillyrosenthal"); "-org" tags this site's previews.
PREVIEW_DOMAIN=preview1.rosenthaltechnologies.com
PREVIEW_PREFIX=lillyrosenthal-org
PREVIEW_MODE=build
HOOK_TIMEOUT_SECONDS=900

# Threads allowed to have a live worktree at once (older ones are parked).
MAX_WORKTREES=3
